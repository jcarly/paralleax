# Leave proxy values empty when no proxy is required.
# Example: http://user:password@proxy.company.local:8080
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,api,web,db

# Local PostgreSQL defaults used by Docker Compose.
POSTGRES_USER=paralleax
POSTGRES_PASSWORD=paralleax
POSTGRES_DB=paralleax
DATABASE_URL=postgres://paralleax:paralleax@db:5432/paralleax
POSTGRES_SSL=false
POSTGRES_SSL_CA=
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional contextual product feedback. Both values are required to enable the
# button; leave both empty to keep the Formbricks SDK disabled.
VITE_FORMBRICKS_WORKSPACE_ID=
VITE_FORMBRICKS_APP_URL=

# Registration is open in local development. Production must explicitly choose
# open, access-code, or closed. access-code also requires a strong secret value.
REGISTRATION_MODE=open
REGISTRATION_ACCESS_CODE=

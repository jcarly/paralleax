# Leave proxy values empty when no proxy is required.
# Example: http://user:password@proxy.company.local:8080
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,api,web,db

# Local PostgreSQL defaults used by Docker Compose.
POSTGRES_USER=paralleax
POSTGRES_PASSWORD=paralleax
POSTGRES_DB=paralleax
DATABASE_URL=postgres://paralleax:paralleax@localhost:5432/paralleax
COMPOSE_DATABASE_URL=postgres://paralleax:paralleax@db:5432/paralleax
POSTGRES_SSL=false
POSTGRES_SSL_CA=
PORT=3000
CORS_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development

# Optional PostHog feedback survey. The public project token (phc_...) and the
# API host are both required to show the button; leave them empty to keep the
# PostHog SDK disabled. Never use a personal API key (phx_...). The survey id
# defaults to the Paralleax feedback survey; set it only for a test survey.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_API_HOST=
VITE_POSTHOG_FEEDBACK_SURVEY_ID=

# Optional Sentry error monitoring. API and browser DSNs can target separate
# Sentry projects. Leave the DSNs empty to disable Sentry completely.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=

# Optional production source-map upload. Keep SENTRY_AUTH_TOKEN in the build
# secret manager; it is never included in the browser image.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=

# Registration is open in local development. Production must explicitly choose
# open or closed. Local development skips email verification by default; set
# DEV_SKIP_EMAIL_VERIFICATION=false to exercise the emailed verification flow.
REGISTRATION_MODE=open
DEV_SKIP_EMAIL_VERIFICATION=true

# Optional transactional email delivery through the Brevo HTTPS API. Set the
# API key and sender together. Keep the API key in your secret manager.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

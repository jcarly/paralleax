{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CheckBucketVersioning",
      "Effect": "Allow",
      "Action": "s3:GetBucketVersioning",
      "Resource": "arn:aws:s3:::REPLACE_WITH_PRIVATE_BUCKET"
    },
    {
      "Sid": "ListBackupPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_PRIVATE_BUCKET",
      "Condition": {
        "StringEquals": {
          "s3:prefix": ["daily/"]
        }
      }
    },
    {
      "Sid": "ReadAndWriteBackupObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_PRIVATE_BUCKET/daily/*",
        "arn:aws:s3:::REPLACE_WITH_PRIVATE_BUCKET/weekly/*",
        "arn:aws:s3:::REPLACE_WITH_PRIVATE_BUCKET/staging/*"
      ]
    }
  ]
}

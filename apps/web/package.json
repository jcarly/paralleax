{
  "name": "@paralleax/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run check:bundle",
    "check:bundle": "node ../../scripts/check-web-bundle.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "playwright:run": "playwright test",
    "playwright:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:acceptance": "playwright test --config playwright.acceptance.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts --repeat-each=3"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lint": "6.9.7",
    "@dnd-kit/core": "^6.3.1",
    "@formbricks/js": "^5.1.0",
    "@paralleax/shared": "^0.1.0",
    "@sentry/react": "^11.10.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@xyflow/react": "^12.12.1",
    "codemirror": "6.0.2",
    "dompurify": "^3.4.17",
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^11.9.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^29.1.1",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}

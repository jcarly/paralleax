{
  "name": "@paralleax/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --builder webpack",
    "build": "nest build --builder webpack && node ../../scripts/smoke-qsp-worker.mjs && node ../../scripts/smoke-choicescript-worker.mjs",
    "start": "node dist/main.js",
    "migrate": "nest start --builder webpack -- --migrate",
    "migrate:prod": "node dist/main.js --migrate",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:postgres": "jest --runInBand stories.postgres.spec.ts comments.postgres.spec.ts database.migrations.postgres.spec.ts",
    "test:stress:postgres": "jest --runInBand stories.stress.postgres.spec.ts",
    "coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.2.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "^6.7.1",
    "@paralleax/shared": "^0.1.0",
    "@sentry/nestjs": "^11.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

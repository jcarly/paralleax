{
  "name": "@paralleax/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --builder webpack",
    "build": "nest build --builder webpack && node ../../scripts/smoke-qsp-worker.mjs && node ../../scripts/smoke-choicescript-worker.mjs",
    "start": "node dist/main.js",
    "migrate": "nest start --builder webpack -- --migrate",
    "migrate:prod": "node dist/main.js --migrate",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../../node_modules/jest/bin/jest.js --runInBand",
    "test:postgres": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../../node_modules/jest/bin/jest.js --runInBand stories.postgres.spec.ts story-access.postgres.spec.ts comments.postgres.spec.ts database.migrations.postgres.spec.ts stories.e2e.spec.ts story-context-history.e2e.spec.ts comments.e2e.spec.ts",
    "test:stress:postgres": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../../node_modules/jest/bin/jest.js --runInBand stories.stress.postgres.spec.ts",
    "coverage": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../../node_modules/jest/bin/jest.js --runInBand --coverage"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.2.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@paralleax/shared": "^0.1.0",
    "@sentry/nestjs": "^11.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "12.5.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "webpack-node-externals": "3.0.0"
  }
}

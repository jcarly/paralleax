{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "../../",
    "paths": {
      "@paralleax/shared": ["packages/shared/src/index.ts"],
      "@paralleax/shared/native-story-validation": [
        "packages/shared/src/native-story-validation.ts"
      ]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*.ts"]
}

# Copy these names into the deployment secret manager. Do not deploy this file
# and never commit real credentials or invitation codes.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://user:replace-me@managed-postgres.example:5432/paralleax
POSTGRES_SSL=true
POSTGRES_SSL_CA=
CORS_ORIGIN=https://alpha.paralleax.example

# Recommended for a private alpha. The access code must contain at least 16
# characters and must be distributed separately from the application URL.
REGISTRATION_MODE=access-code
REGISTRATION_ACCESS_CODE=replace-with-a-long-random-secret

# Port exposed by the local production Compose smoke environment. Public TLS
# must terminate at the hosting provider or an external reverse proxy.
WEB_PORT=8080

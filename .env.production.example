# Copy these names into the deployment secret manager. Do not deploy this file
# and never commit real credentials.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://user:replace-me@managed-postgres.example:5432/paralleax
POSTGRES_SSL=true
POSTGRES_SSL_CA=
CORS_ORIGIN=https://alpha.paralleax.example

# Optional build-time Formbricks feedback configuration. For Formbricks Cloud,
# use https://app.formbricks.com as the app URL.
VITE_FORMBRICKS_WORKSPACE_ID=
VITE_FORMBRICKS_APP_URL=

# Optional Sentry error monitoring. API and browser DSNs can target separate
# projects. Use the immutable image commit or digest as the common release.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=

# Optional browser source-map upload. Configure these only in the web build
# environment. SENTRY_AUTH_TOKEN is a build secret and must never be committed.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=

# Open registrations create unverified accounts and require email verification.
# Set this to closed when no more accounts should be created.
REGISTRATION_MODE=open

# Transactional account email through the Brevo HTTPS API. Create a Brevo API
# key, not an SMTP key, and keep it in the deployment secret manager.
BREVO_API_KEY=replace-with-a-brevo-api-key
EMAIL_FROM=Paralleax <accounts@alpha.paralleax.example>
EMAIL_REPLY_TO=

# Port exposed by the local production Compose smoke environment. Public TLS
# must terminate at the hosting provider or an external reverse proxy.
WEB_PORT=8080
